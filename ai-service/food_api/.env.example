# AI Service Environment Configuration
AI_SERVICE_SECRET_KEY=dev-internal-secret-key-change-in-prod
AI_SERVICE_SECRET_KEYS=

# ONNX Runtime Concurrency & Thread Limits
AI_ONNX_INTRA_THREADS=3
AI_ONNX_INTER_THREADS=1

# Admission Control Limits
AI_MAX_CONCURRENT_INFERENCES=1
AI_MAX_WAITING=4

# Model Paths & Testing
AI_MODEL_PATH=best_foodinsseg.onnx
AI_CAT_NAMES_PATH=cat_names.json
AI_ALLOW_MISSING_MODEL=false
