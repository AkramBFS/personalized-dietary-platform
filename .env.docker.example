# ── Database (PostgreSQL 17) ──────────────────────────────────
POSTGRES_DB=nutriplatform_db
POSTGRES_USER=nutriplatform_user
POSTGRES_PASSWORD=change_this_postgres_password_in_production
DB_PORT=5432

# ── Django Backend ───────────────────────────────────────────
SECRET_KEY=change_this_django_secret_key_in_production_min_50_chars
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend

# Encryption keys for sensitive data
ENCRYPTION_PRIMARY_KEY=c3Ryb25nLWZlcm5ldC1rZXktZm9yLXRlc3RpbmctMTIzNDU=
ENCRYPTION_FALLBACK_KEYS=

# External API Keys
GROQ_API_KEY=mock-or-real-groq-api-key
CALORIE_NINJAS_KEY=mock-or-real-calorie-ninjas-key

# Stripe
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
ALLOWED_TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# Gunicorn tuning
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# ── AI Service & Worker ──────────────────────────────────────
AI_SERVICE_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AI_SERVICE_URL=http://ai-service:8001
AI_MODEL_HOST_PATH=./ai-service/food_api/best_foodinsseg.onnx
AI_ORT_THREADS=2

# ── Frontend (Next.js) ───────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1/
NEXT_PUBLIC_DJANGO_ORIGIN=http://127.0.0.1:8000
INTERNAL_DJANGO_URL=http://backend:8000/api/v1/
